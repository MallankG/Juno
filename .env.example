# ---- Model (pick one) ----
# AI Gateway (Vercel; a free starter credit may apply, check your account):
AI_GATEWAY_API_KEY=
# or call Anthropic directly if you switch agent/agent.ts to the eve helper:
# ANTHROPIC_API_KEY=

# ---- Memory (Supermemory free tier: $5 of credits a month) ----
# Create a key at https://console.supermemory.ai/keys
SUPERMEMORY_API_KEY=

# ---- Accounts ----
# Invite code people need to create an account (choose something only you share)
INVITE_CODE=
# Optional first admin login (also works as an account)
ASSISTANT_USERNAME=
ASSISTANT_PASSWORD=

# ---- Where the agent lives (used for Google sign-in and scheduled jobs) ----
# Your public address, e.g. https://juno.vercel.app (locally: http://localhost:2000)
APP_URL=
# Long random string. Scheduled jobs send it to prove they are allowed to run.
CRON_SECRET=

# ---- Google Calendar and Gmail (free). One OAuth client for everyone. ----
# Redirect URI to add in Google Cloud: <APP_URL>/eve/v1/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Voice (Deepgram: $200 free credit, no expiry) ----
DEEPGRAM_API_KEY=

# ---- Notifications (free). Generate with: npx web-push generate-vapid-keys ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Vercel Blob (durable storage on Vercel; a PRIVATE store) ----
BLOB_READ_WRITE_TOKEN=

# ---- Slack (optional, free; one workspace for the whole household) ----
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=

# Model. Pick one.
# AI Gateway (Vercel AI Gateway; free starter credit may apply, check your account):
AI_GATEWAY_API_KEY=
# or call Anthropic directly if you use the eve helper in agent/agent.ts:
# ANTHROPIC_API_KEY=

# Long-term memory (Supermemory free tier: $5 of credits a month).
# Create a key at https://console.supermemory.ai/keys
SUPERMEMORY_API_KEY=

# Google Calendar + Gmail (free). See README "Connect Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Voice (Deepgram: $200 free credit, no expiry). Speech-to-text and text-to-speech.
# Create a key at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Sign-in for your phone and browser. Choose your own values.
ASSISTANT_USERNAME=
ASSISTANT_PASSWORD=

# Slack (optional, free). Bot token with channels:history and channels:read.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=

# Durable storage on Vercel: a PRIVATE Blob store (created in the Vercel dashboard).
# Leave empty locally to use .eve-data/learning.json.
BLOB_READ_WRITE_TOKEN=

# Optional: stable id for the owner's memory, used by scheduled runs.
ASSISTANT_OWNER_ID=owner
